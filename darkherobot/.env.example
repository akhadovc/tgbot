# ---- Majburiy (kalitlarni faqat .env fayliga yozing, hech kimga yubormang) ----
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# ---- Egasi va guruhlar (/id buyrug'i bilan ID'larni bilib olasiz) ----
# Egasi: limitsiz, /usage ko'radi. Bir nechta bo'lsa vergul bilan.
OWNER_IDS=
# Bo'sh = hamma guruhda ishlaydi. To'ldirsangiz faqat shu guruhlarda.
ALLOWED_GROUP_IDS=
# all = shaxsiyda hamma yoza oladi, owner = shaxsiyda faqat egasi
PRIVATE_ACCESS=all
TRIGGER_WORDS=diddy

# ---- Model ----
OPENAI_MODEL=gpt-6.1-sol
# low | medium | high | xhigh | max  (yuqori = aqlliroq, lekin sekin va qimmat)
CHAT_EFFORT=low
RESEARCH_EFFORT=high
MAX_OUTPUT_TOKENS=1500
RESEARCH_MAX_OUTPUT_TOKENS=4000
WEB_SEARCH=true

# ---- Byudjet (oy davomida yetishi uchun) ----
MONTHLY_BUDGET_USD=20
DAILY_USER_LIMIT=40
# gpt-6.1-sol narxlari, USD / 1M token; qidiruv: 1 ta chaqiruv narxi
PRICE_INPUT_PER_M=2.0
PRICE_CACHED_INPUT_PER_M=0.10
PRICE_OUTPUT_PER_M=10.0
PRICE_WEB_SEARCH_CALL=0.01

# ---- Guruh tarixi va xotira ----
HISTORY_HOURS=24
HISTORY_CONTEXT_MESSAGES=60
HISTORY_CONTEXT_CHARS=9000
PRIVATE_MEMORY_TURNS=6
DB_PATH=diddy.db

# ---- Video (faqat reply orqali: videoga reply qilib "Diddy" deyish) ----
VIDEO_ENABLED=true
# 600 = 10 daqiqada bitta video (butun bot bo'yicha); qolganlari navbatda kutadi
VIDEO_INTERVAL_SECONDS=600
VIDEO_QUEUE_MAX=5
VIDEO_MAX_MB=20
VIDEO_FRAMES=8
VIDEO_MAX_AUDIO_SECONDS=600
TRANSCRIBE_MODEL=gpt-transcribe
PRICE_TRANSCRIBE_PER_MIN=0.0045
