# Diddy sozlamalari (maxfiy emas). Kalitlar .env faylida turadi.
# O'zgartirgandan keyin restart_diddy.bat ni bosing.

# Egasi: limitsiz, /usage ko'radi, bot muammo bo'lsa xabar yuboradi.
OWNER_IDS=

# Telegram Business (shaxsiy chatlaringizda sizning nomingizdan javob berish):
#   all     = sizga yozgan hamma odamga javob beradi (siz /pauza demaguningizcha)
#   trigger = faqat kimdir "Diddy" deb yozsa javob beradi
#   off     = shaxsiy chatlarda umuman javob bermaydi
# Ayrim odamlarni Telegram'ning o'zida (Business -> Chatbots) chiqarib qo'ysangiz, bot ularga yozmaydi.
BUSINESS_MODE=all
# shaddot = guruhdagidek roast; yumshoq = hurmat bilan, yengil hazil
BUSINESS_TONE=shaddot
# true = bot kimgadir javob bersa, sizga bot chatida xabar yuboradi
BUSINESS_NOTIFY=true
# Odam ketma-ket bir nechta xabar yozsa, shuncha soniya kutib, hammasiga BITTA javob beradi
BUSINESS_DEBOUNCE_SECONDS=6
